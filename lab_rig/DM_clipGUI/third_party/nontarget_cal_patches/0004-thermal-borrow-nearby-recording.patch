+def thermal_evidence(bag: Bag, cfg, series, tns):
+    """(geo, rep) of the thermal pair, voted one moment at a time (identify_thermal_votes). rep["confident"]:
+    enough sideways moments to stand against a map. A single moment flips about 1 time in 6 (10-03 vehicle bags:
+    164748 6:1, 164412 5:1), so 2-3 moments say little — 164612 had 2, both flipped."""
+    times = moments(bag, series["t"], series["speed"], n=cfg.get("names", {}).get("moments", 6))
+    fr = grab_frames(bag, cfg, "thermal", tns, times + [t + 2_000_000_000 for t in times])
+    K_th = np.array([680.0, 680.0, 320.0, 240.0, 0.0, 0.0])
+    votes = []
+    for f in fr:        # one moment at a time — see identify_thermal_votes
+        votes += list(pair_geometry([f], lambda ns: K_th, _pinhole_unproject, min_inliers=20).items())
+    geo, rep = identify_thermal_votes(votes, tns)
+    rep["decisive"] = sum(1 for tx, _ in rep.get("votes_tx_inliers", []) if abs(tx) > 0.5)
+    rep["min_confident"] = cfg.get("names", {}).get("thermal_min_votes_to_contradict", 4)
+    rep["confident"] = bool(geo is not None and not rep["unresolved"] and rep["decisive"] >= rep["min_confident"])
+    return geo, rep
+
+
+def bag_span(path):
+    """(start, end) ns of a recording from its metadata.yaml, or None."""
+    m = Path(path) / "metadata.yaml"
+    try:
+        md = yaml.safe_load(m.read_text())["rosbag2_bagfile_information"]
+        t0 = int(md["starting_time"]["nanoseconds_since_epoch"])
+        return t0, t0 + int(md["duration"]["nanoseconds"])
+    except (OSError, KeyError, TypeError, yaml.YAMLError):
+        return None
+
+
+def _thermal_serials(path):
+    """{namespace: serial} of the thermal cameras from DM_clipGUI's dataset_info.json, {} if absent."""
+    try:
+        cams = json.loads((Path(path) / "dataset_info.json").read_text()).get("cameras") or {}
+    except (OSError, ValueError):
+        return {}
+    return {ns: sn for sn, ns in cams.items() if str(ns).startswith("thermal")}
+
+
+def neighbour_bags(path, job_paths, window_s):
+    """Recordings within window_s of this one (gap between the two spans), nearest first: the job's bags and the
+    recordings next to it in the same folder. A neighbour whose thermal namespace→serial differs from this bag's
+    (dataset_info.json) is left out — its left/right would be about other cameras."""
+    path = Path(path).resolve()
+    me = bag_span(path)
+    if me is None or not path.is_dir():
+        return []
+    mine = _thermal_serials(path)
+    cands = {Path(p).resolve() for p in job_paths}
+    cands |= {p.resolve() for p in path.parent.iterdir() if p.is_dir() and (p / "metadata.yaml").is_file()}
+    cands.discard(path)
+    out = []
+    for c in cands:
+        sp = bag_span(c)
+        if sp is None:
+            continue
+        gap = max(0, max(sp[0], me[0]) - min(sp[1], me[1])) / 1e9
+        theirs = _thermal_serials(c)
+        if gap <= window_s and not (mine and theirs and mine != theirs):
+            out.append((gap, str(c)))
+    return [(Path(c), gap) for gap, c in sorted(out)]
+
