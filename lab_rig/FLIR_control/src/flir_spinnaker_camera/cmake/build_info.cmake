# Writes OUT (a .cpp defining kFlirDriverGitDescribe) from `git describe` of SRC_DIR, rewriting it
# only when the text changes so an unchanged tree does not relink. Run on every build.
execute_process(
  COMMAND git -C "${SRC_DIR}" describe --always --dirty --tags
  OUTPUT_VARIABLE _describe
  ERROR_QUIET
  OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(
  COMMAND git -C "${SRC_DIR}" rev-parse --abbrev-ref HEAD
  OUTPUT_VARIABLE _branch
  ERROR_QUIET
  OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _describe)
  set(_describe "unknown")
endif()
if(_branch)
  set(_describe "${_branch}@${_describe}")
endif()
set(_text "// generated by cmake/build_info.cmake\nextern const char * const kFlirDriverGitDescribe;\nconst char * const kFlirDriverGitDescribe = \"${_describe}\";\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
else()
  set(_old "")
endif()
if(NOT _old STREQUAL _text)
  file(WRITE "${OUT}" "${_text}")
endif()
